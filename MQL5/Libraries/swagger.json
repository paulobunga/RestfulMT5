    "/candles/{symbol}": {
      "get": {
        "tags": [
          "candles"
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Trading symbol (e.g., EURUSD, .USTECHCash)"
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "M1",
              "M5",
              "M15",
              "M30",
              "H1",
              "H4",
              "D1",
              "W1",
              "MN1"
            ],
            "default": "M5",
            "description": "Candlestick timeframe"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 20,
            "description": "Number of candles to retrieve"
          },
          {
            "name": "start_pos",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 0,
            "description": "Starting position (0 = most recent candle)"
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Get OHLCV candlestick data",
        "operationId": "candles",
        "description": "Retrieves OHLCV (Open, High, Low, Close, Volume) candlestick data for a specified symbol and timeframe.\n",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Array of candles in JSON",
            "schema": {
              "$ref": "#/definitions/CandlesResponse"
            }
          },
          "400": {
            "description": "Bad input parameter"
          },
          "404": {
            "description": "Symbol not found"
          }
        }
      }
    },
    "/deals": {
      "get": {
        "tags": [
          "deal"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "get account deals",
        "operationId": "dealrequest",
        "description": "Loads Account Deals with pagination and filters.\nSupports offset/limit paging, position_id/symbol/from/to filters, returns wrapped {deals, total}.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 0,
            "description": "Zero-based offset into filtered deals (newest first)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 100,
            "description": "Page size 1..500, default 100"
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Filter by position ticket (0 = no filter)"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Filter by symbol (empty = no filter)"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Start time (epoch seconds/millis or ISO-8601). Default 0."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "End time (epoch seconds/millis or ISO-8601). Default TimeCurrent()."
          }
        ],
        "responses": {
          "200": {
            "description": "wrapped deals + total",
            "schema": {
              "$ref": "#/definitions/DealList"
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/ping": {
      "get": {
        "tags": [
          "account"
        ],
        "security": [
