    "/history": {
      "get": {
        "tags": [
          "order"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "get account orders history",
        "operationId": "orders_history",
        "description": "Loads Account Orders History with pagination and filters. Returns {orders, total} with real fill price.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "orders array in json",
            "schema": {
              "$ref": "#/definitions/OrderList"
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 0,
            "description": "Offset into filtered history (newest first)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 100,
            "description": "Page size 1..500"
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Filter by position ticket"
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Filter by symbol"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Start time (epoch or ISO)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "End time (epoch or ISO)"
          }
        ]
      }
    },
